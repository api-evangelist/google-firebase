{
  "opencollection": "1.0.0",
  "info": {
    "name": "Google Firebase Firebase Cloud Messaging API (FCM) Data Messages API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://accounts.google.com/o/oauth2/auth",
      "accessTokenUrl": "https://oauth2.googleapis.com/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Messages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Google Firebase Send a message",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://fcm.googleapis.com/v1/projects/:projectId/messages:send",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "The Firebase project ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sends a message to the specified target (device token, topic, or condition). Supports notification payloads, data payloads, and platform-specific overrides."
        }
      ]
    }
  ],
  "bundled": true
}